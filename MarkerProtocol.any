//// Trunk markers

#ifdef _RSHO
CreateMarkerDriver RSHO (
MarkerPlacement=Right.ShoulderArm.Segments.Clavicula,
OptX=ON,OptY=OFF,OptZ=OFF,
WeightX=1,WeightY=1,WeightZ=1,
PlaceMarkerAt = acj,
// We align the marker direction with acj so the marker is locked in the directions perpendicula 
// to rotation around sternum. 
AlignMarkerWith = acj, 
ScaleMarkerPosOnOff=OFF,
) = {
  sRelOpt = {0, 0.02, 0};
};
#endif

#ifdef _LSHO
// Marker on the Left Acromio-clavicular joint
CreateMarkerDriver LSHO (
MarkerPlacement=Left.ShoulderArm.Segments.Clavicula,
OptX=ON,OptY=OFF,OptZ=OFF,
WeightX=1,WeightY=1,WeightZ=1,
PlaceMarkerAt = acj,
AlignMarkerWith = acj, 
ScaleMarkerPosOnOff=OFF,
) = {
  sRelOpt = {0, -0.02, -0.00};
};
#endif


