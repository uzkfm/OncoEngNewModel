Main.ModelSetup.LabSpecificData = {

  #path BODY_MODEL_CONFIG_FILE "BodyModelConfig.any"

  #path MOCAP_MARKER_PROTOCOL_FILE "MarkerProtocol.any"

  #path MOCAP_EXTRA_DRIVERS_FILE "ExtraDrivers.any"

  // The switch MOCAP_C3D_DATA_PATH can be used to specify the directory
  // where the C3D file is stored. Defaults to the main file directory.
  #path MOCAP_C3D_DATA_PATH "Subjects/"+SUBJECT+"/Inputs/"

  #path MOCAP_C3DSETTINGS "C3DSettings.any"

  #ifndef MOCAP_FORCE_PLATE_FILE
  #path MOCAP_FORCE_PLATE_FILE "ForcePlates.any"
  #endif

  // Controls where the Human-Ground residuals (hand of god) are applied
  // to the models. Choises are "Trunk" or "Pelvis".
  #define MOCAP_HUMAN_GROUND_RESIDUALS "Pelvis"

  // The low-pass filter cut-off frequencies are relatively low here. This is
  // to compensate for the noise in the recording.
  // A low cut-off frequency is possible since this is a slow excersize.
  // For other activities use higher values and check that the filter
  // does not alter the actual signal. (Suitable values for normal gait are 5/10).
  LowPassFilterSettings.MarkerFilterCutOffFrequency = 3;
  LowPassFilterSettings.ForceFilterCutOffFrequency = 7;

  // Disable the upper bound for muscle recruitment. This improves the stability of the model by
  // preventing the solver from changing if the some muscles becomes over loaded.
  Main.Studies.InverseDynamicStudy.InverseDynamics.Criterion.UpperBoundOnOff = Off;

  /////////////////////////////////////////////////////////////////////////
  // Moved changes which was previously made directly to the AMMR into this LabSpecificData.any file
  /////////////////////////////////////////////////////////////////////////
  Main.HumanModel.BodyModel.SelectedOutput = {
    AnyFolder OncoEng = {
      #include "OncoEng/OncoEngSelectedOutput.any"
    };
  };

  Main.Studies.MarkerTracking = {
    #include "OncoEng/OncoEngJointAngle.any"
  };
  
  Main.Studies.InverseDynamicStudy = {
//    #include "OncoEng/OncoEngJointLoading.any"
    #include "OncoEng/OncoEngSegmentLoading.any"
  };

// Amplifying the weightage for the spine rhythm
  Main.HumanModel.BodyModel.Trunk.Joints.Cervical.Flexion.rhythmC2C7 = {Weights.Fun.Value = repmat(nDim, 0.15);};
  Main.HumanModel.BodyModel.Trunk.Joints.Cervical.LateralBending.rhythmC2C7 = {Weights.Fun.Value = repmat(nDim, 0.15);};
  Main.HumanModel.BodyModel.Trunk.Joints.Cervical.Rotation.rhythmC2C7 = {Weights.Fun.Value = repmat(nDim, 0.15);};
  Main.HumanModel.BodyModel.Trunk.Joints.Thorax.ExtensionRhythmDriver = {Weights.Fun.Value = repmat(nDim, 0.15);};
  Main.HumanModel.BodyModel.Trunk.Joints.Thorax.LateralBendingRhythmDriver = {Weights.Fun.Value = repmat(nDim, 0.15);};
  Main.HumanModel.BodyModel.Trunk.Joints.Thorax.AxialRotationRhythmDriver = {Weights.Fun.Value = repmat(nDim, 0.15);};
  Main.HumanModel.BodyModel.Trunk.Joints.Lumbar.SpineRhythmDrvFlexion = {Weights.Fun.Value = repmat(nDim, 0.15);};
  Main.HumanModel.BodyModel.Trunk.Joints.Lumbar.SpineRhythmDrvLatBending = {Weights.Fun.Value = repmat(nDim, 0.15);};
  Main.HumanModel.BodyModel.Trunk.Joints.Lumbar.SpineRhythmDrvRotation = {Weights.Fun.Value = repmat(nDim, 0.15);};
 
  /////////////////////////////////////////////////////////////////////////

  // Only use a single time step in parameter optimization
  #define N_STEP_PARAM_OPT 1

  Gravity = -9.81*{0,0,1};

  
  // Link head (X,Y,Z) scaling to the distance between front and back 
  // head markers. 
  Main.HumanModel.Anthropometrics.SegmentScaleFactors.Head = {
     LengthScale = DepthScale;
     WidthScale = DepthScale;
     DepthScale = 1;
  };
  Main.ModelSetup.ParameterIdentification =
   {
     AnyDesVar HeadDepth = {
       Val = Main.HumanModel.Anthropometrics.SegmentScaleFactors.Head.DepthScale;
       Min = 0.5;
       Max = 2;
     };
   };

 
 Main.ModelSetup.TrialSpecificData = {
   ParameterOptimizationConvergenceTol = 0.005;
 };
 
 
  // This adds different segment length as design variables to
  // to the parameter identification study (Main.Studies.ParameterIdentification)
  // This allows the segment length to be optimized in based on the markers/motion
  OptimizeAnthropometricsOnOff OptimizeAntropometricsOnOff (
  PELVIS_WIDTH = OFF,
  NECK_LENGTH = ON,
  TRUNK_HEIGHT= ON,
  TRUNK_WIDTH=OFF,
  RIGHT_THIGH_LENGTH= ON,
  LEFT_THIGH_LENGTH = ON,
  RIGHT_SHANK_LENGTH= ON,
  LEFT_SHANK_LENGTH = ON,
  RIGHT_FOOT_LENGTH= ON,
  LEFT_FOOT_LENGTH = ON,
  RIGHT_UPPERARM_LENGTH= ON,
  LEFT_UPPERARM_LENGTH = ON,
  RIGHT_LOWERARM_LENGTH= ON,
  LEFT_LOWERARM_LENGTH = ON,
  RIGHT_HAND_LENGTH= OFF,
  LEFT_HAND_LENGTH = OFF,
  LEFT_RIGHT_SYMMETRY = ON
  ) ={};

  // Include code for automatic creation of videos
  Main.ModelSetup.Macros = {
    #include "CreateVideo.any"
  };

};
